<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The app is signed with a self-signed identity (no Team ID), so the
       hardened runtime's library validation rejects the bundled
       Sparkle.framework as a team mismatch. This keeps the exception scoped
       to loading the app's own embedded framework. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
