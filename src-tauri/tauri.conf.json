{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tokscale",
  "version": "1.3.1",
  "identifier": "dev.bunnygamezsc.tokscale-gui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Tokscale",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        },
        "label": "main",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../vendor/tokscale/LICENSE": "licenses/tokscale-LICENSE"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "BunnyGamezDev",
      "entitlements": "entitlements.plist",
      "frameworks": ["Sparkle.framework"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2Rjk2OEM4Rjg2NERCOUQKUldTZDIyVDR5R2o1MWdIZERmcUF6M2NYOXZoeHdOVXNiTytnL2w4anJLSnBIeisyaVBCanhYN00K",
      "endpoints": ["https://github.com/BunnyGamezsc/tokscale-gui/releases/latest/download/latest.json"]
    }
  }
}
